.DS_Store
node_modules/

# Machine-local, never published: these track this machine's own rollout,
# not the distributable plugin.
PROJECT.md
GANTT.html
# Progress page: carries session ids, cron ids and this machine's hook paths,
# which are machine internals. The plan it renders is public; the page is not.
PROJECT-VIEW.html
# Submission notes: this machine's paths, its marketplace source, and a
# strategy for a form only the author can open. The public install
# instructions live in README.md and are not duplicated here.
docs/SUBMISSION.md

# python bytecode from running the self-check
__pycache__/
*.pyc

# Rendered dashboards / local build output (carry your own numbers, never publish)
.local-out/

# Python packaging output from `pip install ./mcp-server`, which the README now
# tells every MCP user to run. Untracked build output in `git status` trains a
# reader to skim it, and this repo's push gates depend on that list being read.
mcp-server/build/
*.egg-info/

# STATE.md is machine-local (see below), and its timestamped backups doubly so.
STATE.md.bak-*

# BrotherSBE decision packages: tool output bound to a commit, regenerated by
# `bin/sbe score` on demand. Evidence for a moment, not source of the plugin.
.sbe/
